# ── База и очередь ────────────────────────────────────────────
DATABASE_URL="postgresql://wa:wa_local_password@localhost:5432/wa_saas?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Приложение ────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Секрет сессий: openssl rand -base64 32
AUTH_SECRET=""

# Ключ шифрования токенов Meta и ключей интеграций (32 байта в base64):
# openssl rand -base64 32
# Смена ключа сделает нечитаемыми все ранее сохранённые токены.
ENCRYPTION_KEY=""

# ── WhatsApp ──────────────────────────────────────────────────
# cloud — боевой WhatsApp Business Platform (Cloud API) от Meta.
# mock  — локальная разработка: наружу ничего не уходит, токен не нужен.
# В режиме cloud вебхук принимает запросы ТОЛЬКО с подписью Meta
# (нужен META_APP_SECRET), иначе отклоняет всё.
WHATSAPP_PROVIDER="mock"
# Необязательно: другой адрес Graph API (тестовый стенд, прокси).
WHATSAPP_GRAPH_URL=""
META_APP_ID=""
META_APP_SECRET=""
# ID конфигурации Embedded Signup. Появляется в настройках приложения Meta
# после одобрения Tech Provider — без него кнопка подключения не активна.
META_CONFIG_ID=""
# Произвольная строка, её же вписываем в настройках вебхука в Meta.
META_WEBHOOK_VERIFY_TOKEN=""
# ВАЖНО для сервера: как только задан META_APP_SECRET, вебхук принимает
# только запросы с верной подписью Meta (X-Hub-Signature-256). Без него
# любой, кто знает адрес, может слать «сообщения» и тратить ваш AI-ключ.

# ── AI (спринт 4) ─────────────────────────────────────────────
# Кто отвечает: gemini или anthropic.
# Смена провайдера требует переиндексации базы знаний — векторы несовместимы.
AI_PROVIDER="gemini"

# Вариант 1: Google Gemini — один ключ на генерацию и эмбеддинги.
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_EMBED_MODEL="gemini-embedding-001"
# Необязательно: свой адрес API (прокси). Пусто — официальный Google.
GEMINI_BASE_URL=""

# Вариант 2: Anthropic. Своих эмбеддингов у него нет, поэтому дополнительно
# нужен ключ OpenAI. Тогда: AI_PROVIDER="anthropic", AI_MODEL="claude-sonnet-4-6".
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Хранилище файлов (спринт 5) ───────────────────────────────
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
