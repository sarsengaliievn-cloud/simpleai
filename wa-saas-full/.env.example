# ── База и очередь ────────────────────────────────────────────
DATABASE_URL="postgresql://wa:wa_local_password@localhost:5432/wa_saas?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Приложение ────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Секрет сессий: openssl rand -base64 32
AUTH_SECRET=""

# Ключ шифрования токенов Meta и ключей интеграций (32 байта в base64):
# openssl rand -base64 32
# Смена ключа сделает нечитаемыми все ранее сохранённые токены.
ENCRYPTION_KEY=""

# ── WhatsApp ──────────────────────────────────────────────────
# mock — до спринта 6. Боевой Cloud API появится как 'cloud'.
WHATSAPP_PROVIDER="mock"
META_APP_ID=""
META_APP_SECRET=""
# ID конфигурации Embedded Signup. Появляется в настройках приложения Meta
# после одобрения Tech Provider — без него кнопка подключения не активна.
META_CONFIG_ID=""
# Произвольная строка, её же вписываем в настройках вебхука в Meta.
META_WEBHOOK_VERIFY_TOKEN=""

# ── AI (спринт 4) ─────────────────────────────────────────────
# Кто отвечает: gemini или anthropic.
# Смена провайдера требует переиндексации базы знаний — векторы несовместимы.
AI_PROVIDER="gemini"

# Вариант 1: Google Gemini — один ключ на генерацию и эмбеддинги.
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_EMBED_MODEL="gemini-embedding-001"

# Вариант 2: Anthropic. Своих эмбеддингов у него нет, поэтому дополнительно
# нужен ключ OpenAI. Тогда: AI_PROVIDER="anthropic", AI_MODEL="claude-sonnet-4-6".
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Хранилище файлов (спринт 5) ───────────────────────────────
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
